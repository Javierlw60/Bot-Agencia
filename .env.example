# Autenticación del panel
AUTH_SECRET_KEY=genera_una_clave_larga_y_aleatoria
# Token para listar/borrar agencias de prueba:
#   GET  /admin/agencias?token=...
#   POST /admin/reset-agencias?token=...&confirm=BORRAR_TODO
# ADMIN_RESET_TOKEN=cambia_esto_por_un_secreto_largo
# En local: admin@demo.local siempre usa código 123456 sin WhatsApp.
# Para otros usuarios en desarrollo: AUTH_2FA_DEV=true (o APP_URL/DASHBOARD_BASE_URL con localhost)
# AUTH_2FA_DEV=true
# Línea de WhatsApp para enviar códigos 2FA (puede ser la misma del bot)
# AUTH_WHATSAPP_PHONE_NUMBER_ID=109283746561234  → ver bloque WhatsApp abajo
# Correo de verificación (Resend SDK oficial)
# pip install resend  (ya está en requirements.txt)
# 1) API key en https://resend.com/api-keys
# 2) Verificá el dominio bot-agencias.com.ar en Resend (DNS)
# 3) En Render:
RESEND_API_KEY=re_xxxxxxxx
SMTP_FROM=noreply@bot-agencias.com.ar
# Si el SDK falla, el código reintenta por smtp.resend.com automáticamente.

GEMINI_API_KEY=tu_clave_aqui
# URL pública del dashboard (para que el bot resuelva fotos subidas localmente)
DASHBOARD_BASE_URL=http://127.0.0.1:8000
APP_URL=http://127.0.0.1:8000

# ── Persistencia (IMPORTANTE en Render) ────────────────────────────────────
# Producción: Postgres de Supabase (Settings → Database → URI).
# Preferí el Connection pooler (puerto 6543).
# DATABASE_URL=postgresql://postgres.XXXX:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
#
# Local sin DATABASE_URL → SQLite en ./bot_agencias_multitenant.db
#
# Fotos/uploads: el disco de Render es efímero. Creá un Persistent Disk
# montado p.ej. en /var/data y definí:
# DATA_DIR=/var/data

# Recordatorios automáticos de citas (scheduler en segundo plano)
RECORDATORIOS_ACTIVOS=true
RECORDATORIOS_INTERVALO_MIN=15

# ── WhatsApp Cloud API (Meta) ──────────────────────────────────────────────
# Modo: consola = simula envíos | api = mensajes reales por Graph API
WHATSAPP_MODO=api

# 1) Access Token (Meta → API Setup → Temporary token, o System User permanente)
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxx
# Alias aceptado por el código:
# WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxx

# 2) Phone Number ID (Meta → API Setup → "Phone number ID", NO es el 549…)
WHATSAPP_PHONE_NUMBER_ID=109283746561234
# Alias aceptado:
# PHONE_NUMBER_ID=109283746561234

# 3) Verify Token (lo inventás vos; debe coincidir con Meta → Webhook → Verify token)
WHATSAPP_VERIFY_TOKEN=mi_token_secreto_webhook_2026

# 4) Versión Graph API (opcional; default v21.0)
WHATSAPP_API_VERSION=v21.0

# Línea para códigos 2FA del panel (puede ser la misma que WHATSAPP_PHONE_NUMBER_ID)
AUTH_WHATSAPP_PHONE_NUMBER_ID=109283746561234

# Texto a voz (edge-tts — gratuito, voces neurales en español)
TTS_VOZ=es-AR-ElenaNeural
TTS_MAX_CARACTERES=1500

# Speech-to-Text (audio de WhatsApp → texto)
# STT_MOTOR=auto  → usa GEMINI_API_KEY si está, si no OPENAI_API_KEY, si no local
# STT_MOTOR=gemini|openai|local
STT_MOTOR=auto
STT_IDIOMA=es
# gemini-2.0-flash ya no existe (404). Usar 2.5+ (mismo que el chat del bot).
STT_GEMINI_MODELO=gemini-2.5-flash
# STT_GEMINI_FALLBACKS=gemini-2.5-flash-lite,gemini-3.1-flash-lite
# OPENAI_API_KEY=sk-...   (opcional si usás Gemini)
# STT_MODELO_LOCAL=small  (solo si STT_MOTOR=local + pip install faster-whisper)

# Keep-alive: ping a /health para que Render free no duerma el servicio (~15 min idle).
# Requiere DASHBOARD_BASE_URL/APP_URL pública (https://bot-agencias.com.ar).
# KEEPALIVE_ACTIVO=true
# KEEPALIVE_INTERVALO_MIN=10
# KEEPALIVE_URL=https://bot-agencias.com.ar/health

# Cron de vencimiento de suscripciones (bloqueo automático de agencias)
VENCIMIENTOS_CRON_ACTIVO=true
VENCIMIENTOS_CRON_HORA=6
VENCIMIENTOS_CRON_MINUTO=0

# Mercado Pago (pagos y suscripciones recurrentes)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-tu_access_token
MERCADOPAGO_USER_ID=123456789
MERCADOPAGO_WEBHOOK_SECRET=tu_clave_secreta_webhook
MERCADOPAGO_WEBHOOK_VALIDAR=true
# Plan global opcional (preapproval_plan_id). Si está vacío, se crea suscripción sin plan.
MERCADOPAGO_PLAN_ID=
MERCADOPAGO_SUSCRIPCION_MONTO=29999
MERCADOPAGO_MONEDA=ARS

# Supabase Auth (OAuth). La BD de negocio usa DATABASE_URL (Postgres).
# SUPABASE_URL=https://XXXX.supabase.co
# SUPABASE_ANON_KEY=eyJ...
